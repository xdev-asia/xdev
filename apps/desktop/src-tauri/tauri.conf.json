{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xDev",
  "identifier": "asia.xdev.desktop",
  "build": {
    "beforeDevCommand": "node scripts/ptyd-sidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/ptyd-sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "xDev",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RjdGNjc2NjhDNTU5ODYKUldTR1djVm9kdmIzbGUrcWJFeHpRNS9yNVFMVW5NYm1EVi9qYXZ1YUJUaHZJcFA4UFYvbUZuRnYK",
      "endpoints": [
        "https://github.com/xdev-asia/xdev/releases/latest/download/latest.json"
      ]
    }
  }
}
